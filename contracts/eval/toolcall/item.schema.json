{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "도구 호출 확인 항목(toolcall-v1)",
  "description": "한 줄 = 한 턴. 요청 문장 + 요청자 + 기준일 → 첫 번째로 맞는 행동. 필드 설명은 같은 폴더 README.md에 있습니다.",
  "type": "object",
  "required": ["id", "targetTool", "category", "requester", "referenceDate", "referenceWeekday", "utterance", "expected"],
  "additionalProperties": false,
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "tool", "args"],
          "additionalProperties": false,
          "properties": {"type": {"const": "call"}, "tool": {"type": "string"}, "args": {"type": "object"}}
        },
        {
          "type": "object",
          "required": ["type", "missing"],
          "additionalProperties": false,
          "properties": {"type": {"const": "clarify"}, "missing": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
        }
      ]
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^tc-[0-9]{3}$"},
    "targetTool": {"type": "string"},
    "category": {"enum": ["direct", "clarify", "confusable", "resolve"]},
    "requester": {"type": "string"},
    "referenceDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "referenceWeekday": {"enum": ["월", "화", "수", "목", "금", "토", "일"]},
    "utterance": {"type": "string", "minLength": 1},
    "expected": {"$ref": "#/$defs/action"},
    "alsoAcceptable": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "argMatch": {"type": "object", "additionalProperties": {"enum": ["exact", "date", "set", "normalized", "nonempty", "ignore"]}},
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["as", "operation", "body", "saveAs"],
        "additionalProperties": false,
        "properties": {
          "as": {"type": "string"},
          "operation": {"type": "string"},
          "body": {"type": "object"},
          "saveAs": {"type": "string"}
        }
      }
    },
    "note": {"type": "string"}
  }
}
