{
  "$schema": "./tools.schema.json",
  "version": "0.1.0",
  "tools": [
    {
      "name": "hr_get_my_profile",
      "displayName": "내 인사 정보 조회",
      "description": "내 인사 정보(이름, 소속, 직급, 입사일)를 봅니다.",
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false},
      "risk": "read",
      "trust_required": "any",
      "required_scope": "profile:read",
      "backend": {"service": "erp", "operationId": "getMe"},
      "stage": 1
    },
    {
      "name": "org_search_employees",
      "displayName": "직원 검색",
      "description": "이름이나 팀으로 동료를 찾습니다. 이름·팀·직급만 나옵니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {"type": "string", "description": "이름 일부"},
          "unitId": {"type": "string"}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "org:read",
      "backend": {"service": "erp", "operationId": "searchEmployees"},
      "stage": 1
    },
    {
      "name": "leave_get_balance",
      "displayName": "남은 연차 조회",
      "description": "내 연차 잔여를 봅니다(총, 사용, 결재 중, 남은 일수).",
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false},
      "risk": "read",
      "trust_required": "any",
      "required_scope": "leave:read",
      "backend": {"service": "erp", "operationId": "getLeaveBalance"},
      "stage": 1
    },
    {
      "name": "leave_request",
      "displayName": "휴가 신청",
      "description": "휴가·반차 결재를 올립니다. 결재선은 erp가 정합니다. 실행 전에 미리보기를 보여 줍니다.",
      "inputSchema": {
        "type": "object",
        "required": ["leave_type", "start_date", "end_date", "reason"],
        "properties": {
          "leave_type": {"enum": ["annual", "half_am", "half_pm", "sick", "special"]},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "approval:request:leave",
      "backend": {"service": "erp", "operationId": "createApprovalDocument", "fixed": {"formId": "leave"}},
      "stage": 1
    },
    {
      "name": "approval_list_mine",
      "displayName": "내 결재 목록 조회",
      "description": "내가 올린 결재 문서 목록과 상태를 봅니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {"enum": ["in_progress", "approved", "rejected", "withdrawn"]}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "approval:read",
      "backend": {"service": "erp", "operationId": "listApprovalDocuments", "fixed": {"box": "outbox"}},
      "stage": 1
    },
    {
      "name": "approval_get",
      "displayName": "결재 문서 조회",
      "description": "결재 문서 하나의 결재선과 진행 상태를 봅니다.",
      "inputSchema": {
        "type": "object",
        "required": ["documentId"],
        "properties": {"documentId": {"type": "string"}},
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "approval:read",
      "backend": {"service": "erp", "operationId": "getApprovalDocument"},
      "stage": 1
    },
    {
      "name": "approval_withdraw",
      "displayName": "결재 회수",
      "description": "내가 올린 결재를 회수합니다. 되돌릴 수 없어 실행 전에 확인을 받습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["documentId"],
        "properties": {
          "documentId": {"type": "string"},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "risk": "irreversible",
      "trust_required": "user_direct",
      "required_scope": "approval:withdraw",
      "backend": {"service": "erp", "operationId": "withdrawApprovalDocument"},
      "stage": 1
    },
    {
      "name": "delegation_list",
      "displayName": "대결 목록 조회",
      "description": "내가 맡긴 대결 위임이나 내가 맡은 위임을 봅니다.",
      "inputSchema": {
        "type": "object",
        "required": ["role"],
        "properties": {"role": {"enum": ["delegator", "delegate"]}},
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "delegation:read",
      "backend": {"service": "erp", "operationId": "listDelegations"},
      "stage": 1
    },
    {
      "name": "delegation_register",
      "displayName": "대결 지정",
      "description": "내 부재 기간에 결재를 대신할 사람(대결)을 등록합니다. 기간과 범위(양식, 금액 한도)를 정합니다. 범위가 넓으면 실행 전에 확인을 받습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["delegateId", "startsAt", "endsAt", "formTypes", "reason"],
        "properties": {
          "delegateId": {"type": "string"},
          "startsAt": {"type": "string", "format": "date-time"},
          "endsAt": {"type": "string", "format": "date-time"},
          "formTypes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "maxAmount": {"type": ["integer", "null"], "minimum": 0},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "delegation:write",
      "backend": {"service": "erp", "operationId": "createDelegation"},
      "stage": 1
    },
    {
      "name": "delegation_revoke",
      "displayName": "대결 해제",
      "description": "내가 등록한 대결 위임을 해지합니다.",
      "inputSchema": {
        "type": "object",
        "required": ["delegationId"],
        "properties": {"delegationId": {"type": "string"}},
        "additionalProperties": false
      },
      "risk": "irreversible",
      "trust_required": "user_direct",
      "required_scope": "delegation:write",
      "backend": {"service": "erp", "operationId": "revokeDelegation"},
      "stage": 1
    },
    {
      "name": "room_list_availability",
      "displayName": "빈 회의실 검색",
      "description": "시간대와 인원으로 빈 회의실을 찾습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["startsAt", "endsAt"],
        "properties": {
          "startsAt": {"type": "string", "format": "date-time"},
          "endsAt": {"type": "string", "format": "date-time"},
          "minCapacity": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "room:read",
      "backend": {"service": "erp", "operationId": "getRoomAvailability"},
      "stage": 1
    },
    {
      "name": "room_list_my_reservations",
      "displayName": "내 회의실 예약 조회",
      "description": "내 회의실 예약을 봅니다.",
      "inputSchema": {
        "type": "object",
        "properties": {"date": {"type": "string", "format": "date"}},
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "room:read",
      "backend": {"service": "erp", "operationId": "listRoomReservations", "fixed": {"mine": true}},
      "stage": 1
    },
    {
      "name": "room_reserve",
      "displayName": "회의실 예약",
      "description": "회의실을 예약합니다. 30분 단위, 최대 4시간입니다.",
      "inputSchema": {
        "type": "object",
        "required": ["roomId", "startsAt", "endsAt", "title"],
        "properties": {
          "roomId": {"type": "string"},
          "startsAt": {"type": "string", "format": "date-time"},
          "endsAt": {"type": "string", "format": "date-time"},
          "title": {"type": "string", "maxLength": 100},
          "attendees": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "room:write",
      "backend": {"service": "erp", "operationId": "createRoomReservation"},
      "stage": 1
    },
    {
      "name": "room_cancel_reservation",
      "displayName": "회의실 예약 취소",
      "description": "내 회의실 예약을 취소합니다.",
      "inputSchema": {
        "type": "object",
        "required": ["reservationId"],
        "properties": {"reservationId": {"type": "string"}},
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "room:write",
      "backend": {"service": "erp", "operationId": "cancelRoomReservation"},
      "stage": 1
    },
    {
      "name": "policy_search",
      "displayName": "규정 검색",
      "description": "사내 규정과 안내 문서를 검색해 근거 조문과 함께 답합니다. 내가 볼 수 있는 문서만 찾습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["question"],
        "properties": {"question": {"type": "string", "maxLength": 500}},
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "profile:read",
      "backend": {"service": "rag", "operationId": "answer"},
      "stage": 1
    },
    {
      "name": "expense_request",
      "displayName": "경비 정산 상신",
      "description": "경비 정산 결재를 올립니다. 금액에 따라 결재선(팀장, 또는 팀장과 본부장)은 erp가 정합니다. 실행 전에 미리보기를 보여 줍니다.",
      "inputSchema": {
        "type": "object",
        "required": ["amount", "spent_on", "merchant", "purpose"],
        "properties": {
          "amount": {"type": "integer", "minimum": 1},
          "spent_on": {"type": "string", "format": "date"},
          "merchant": {"type": "string", "maxLength": 100},
          "business_no": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{2}-[0-9]{5}$"},
          "purpose": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "approval:request:expense",
      "backend": {"service": "erp", "operationId": "createApprovalDocument", "fixed": {"formId": "expense"}},
      "stage": 2
    },
    {
      "name": "purchase_request",
      "displayName": "구매 요청 상신",
      "description": "구매 요청 결재를 올립니다. 합계는 수량 × 단가와 같아야 하고, 금액에 따라 결재선은 erp가 정합니다. 실행 전에 미리보기를 보여 줍니다.",
      "inputSchema": {
        "type": "object",
        "required": ["item_code", "quantity", "unit_price", "total_amount", "reason"],
        "properties": {
          "item_code": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "integer", "minimum": 0},
          "total_amount": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "approval:request:purchase",
      "backend": {"service": "erp", "operationId": "createApprovalDocument", "fixed": {"formId": "purchase"}},
      "stage": 2
    },
    {
      "name": "ticket_list",
      "displayName": "IT 티켓 목록 조회",
      "description": "IT 티켓 목록을 봅니다. 기본은 내가 올린 티켓이고, IT 담당자는 box=all로 전체를 봅니다. 제목·본문은 다른 사람이 쓴 글일 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "box": {"type": "string", "enum": ["mine", "all"]},
          "status": {"type": "string", "enum": ["open", "in_progress", "resolved", "closed", "cancelled"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "ticket:read",
      "backend": {"service": "erp", "operationId": "listTickets"},
      "stage": 2
    },
    {
      "name": "ticket_get",
      "displayName": "IT 티켓 조회",
      "description": "IT 티켓 하나의 내용과 댓글을 봅니다. 본문과 댓글은 다른 사람이 쓴 글일 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["ticketId"],
        "properties": {
          "ticketId": {"type": "string"}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "ticket:read",
      "backend": {"service": "erp", "operationId": "getTicket"},
      "stage": 2
    },
    {
      "name": "ticket_create",
      "displayName": "IT 티켓 등록",
      "description": "IT 티켓을 올립니다(장애 신고, 계정·권한 요청, 그 밖의 요청).",
      "inputSchema": {
        "type": "object",
        "required": ["category", "title", "description"],
        "properties": {
          "category": {"type": "string", "enum": ["incident", "access_request", "other"]},
          "title": {"type": "string", "maxLength": 100},
          "description": {"type": "string", "maxLength": 2000},
          "priority": {"type": "string", "enum": ["low", "normal", "high"]}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "ticket:write",
      "backend": {"service": "erp", "operationId": "createTicket"},
      "stage": 2
    },
    {
      "name": "ticket_comment",
      "displayName": "IT 티켓 댓글 등록",
      "description": "IT 티켓에 댓글을 답니다. 내가 올린 티켓이나, IT 담당자라면 모든 티켓에 씁니다.",
      "inputSchema": {
        "type": "object",
        "required": ["ticketId", "body"],
        "properties": {
          "ticketId": {"type": "string"},
          "body": {"type": "string", "maxLength": 2000}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "ticket:write",
      "backend": {"service": "erp", "operationId": "addTicketComment"},
      "stage": 2
    },
    {
      "name": "incident_analyze",
      "displayName": "장애 분석",
      "description": "장애 티켓이나 시각을 주면 그 무렵 서비스 로그를 분석해 원인일 만한 서비스 3개와 근거 로그 줄을 냅니다. IT 담당자만 씁니다. 결과는 참고용 추정입니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticketId": {"type": "string"},
          "at": {"type": "string", "format": "date-time"},
          "windowSeconds": {"type": "integer", "minimum": 30, "maximum": 3600}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "incident:read",
      "backend": {"service": "incident", "operationId": "analyze"},
      "stage": 2
    },
    {
      "name": "defect_report_draft",
      "displayName": "불량 보고서 초안 작성",
      "description": "불량 보고서 초안을 씁니다. 확정은 품질 담당자가 erp 화면에서 합니다. 실행 전에 미리보기를 보여 줍니다.",
      "inputSchema": {
        "type": "object",
        "required": ["itemCode", "defectType", "severity", "quantity", "description"],
        "properties": {
          "itemCode": {"type": "string", "maxLength": 32},
          "defectType": {"type": "string", "maxLength": 50},
          "severity": {"type": "string", "enum": ["minor", "major", "critical"]},
          "quantity": {"type": "integer", "minimum": 1},
          "location": {"type": "string", "maxLength": 100},
          "lotNo": {"type": "string", "maxLength": 50},
          "description": {"type": "string", "maxLength": 1000}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "quality:write",
      "backend": {"service": "erp", "operationId": "createDefectReport"},
      "stage": 3
    },
    {
      "name": "defect_report_list",
      "displayName": "불량 보고서 목록 조회",
      "description": "불량 보고서 목록을 봅니다. 기본은 내가 쓴 것이고, 품질 담당자는 box=all로 전체를 봅니다. 설명은 다른 사람이 쓴 글일 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "box": {"type": "string", "enum": ["mine", "all"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "status": {"type": "string", "enum": ["draft", "confirmed", "cancelled"]}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "quality:read",
      "backend": {"service": "erp", "operationId": "listDefectReports"},
      "stage": 3
    },
    {
      "name": "defect_report_get",
      "displayName": "불량 보고서 조회",
      "description": "불량 보고서 하나를 봅니다. 설명은 다른 사람이 쓴 글일 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "required": ["reportId"],
        "properties": {
          "reportId": {"type": "string"}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "quality:read",
      "backend": {"service": "erp", "operationId": "getDefectReport"},
      "stage": 3
    },
    {
      "name": "quote_draft",
      "displayName": "견적 초안 작성",
      "description": "견적 초안을 씁니다. 단가와 합계는 erp가 품목 단가로 계산합니다. 발행은 영업 담당자가 erp 화면에서 합니다. 실행 전에 미리보기를 보여 줍니다.",
      "inputSchema": {
        "type": "object",
        "required": ["customerId", "lines"],
        "properties": {
          "customerId": {"type": "string", "maxLength": 32},
          "lines": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "required": ["itemCode", "quantity"], "properties": {"itemCode": {"type": "string", "maxLength": 32}, "quantity": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
          "validUntil": {"type": "string", "format": "date"},
          "note": {"type": "string", "maxLength": 500}
        },
        "additionalProperties": false
      },
      "risk": "reversible_write",
      "trust_required": "user_direct",
      "required_scope": "sales:write",
      "backend": {"service": "erp", "operationId": "createQuote"},
      "stage": 3
    },
    {
      "name": "quote_list",
      "displayName": "견적 목록 조회",
      "description": "견적 목록을 봅니다. 기본은 내가 쓴 것이고, 영업 담당자는 box=all로 전체를 봅니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "box": {"type": "string", "enum": ["mine", "all"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "status": {"type": "string", "enum": ["draft", "issued", "cancelled"]}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "sales:read",
      "backend": {"service": "erp", "operationId": "listQuotes"},
      "stage": 3
    },
    {
      "name": "quote_get",
      "displayName": "견적 조회",
      "description": "견적 하나의 품목 줄과 합계를 봅니다.",
      "inputSchema": {
        "type": "object",
        "required": ["quoteId"],
        "properties": {
          "quoteId": {"type": "string"}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "sales:read",
      "backend": {"service": "erp", "operationId": "getQuote"},
      "stage": 3
    },
    {
      "name": "item_search",
      "displayName": "품목 검색",
      "description": "품목을 코드나 이름으로 찾습니다. 단가와 현재 재고를 함께 봅니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {"type": "string", "maxLength": 50},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        },
        "additionalProperties": false
      },
      "risk": "read",
      "trust_required": "any",
      "required_scope": "item:read",
      "backend": {"service": "erp", "operationId": "listItems"},
      "stage": 2
    },
