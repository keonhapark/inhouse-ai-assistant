# 값은 .env에만 넣습니다. 이 파일에는 이름만 둡니다.

# 세션 번호(0~6). 포트는 8000 + 100 × 세션 번호에서 시작합니다(docs/ports.md).
SESSION_NO=0

# 외부 LLM(gateway만 읽습니다)
ANTHROPIC_API_KEY=

# 로컬 LLM
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL=qwen3.5:9b

# erp 사용자 JWT 서명 키(HS256, 32바이트 이상)
ERP_JWT_SECRET=

# 개발용 직원 공통 비밀번호(가짜 직원 데이터용)
ERP_DEMO_PASSWORD=

# 위임 토큰(ES256) 키 경로. scripts/dev-keys.sh가 만듭니다.
DELEGATION_TOKEN_PRIVATE_KEY=infra/dev-keys/delegation-es256.pem
DELEGATION_TOKEN_PUBLIC_KEY=infra/dev-keys/delegation-es256.pub.pem

# 법제처 Open API 인증값(OC). 1단계는 고정본을 쓰므로 비워 둬도 됩니다.
LAW_OPEN_API_OC=

# PostgreSQL
POSTGRES_PASSWORD=

# LiteLLM 프록시 키(gateway와 litellm이 같이 씀). sk-로 시작하는 임의 문자열
LITELLM_MASTER_KEY=

# agent가 켤 팩 단계. 비우면 pack.yaml의 stage. 1단계 평가를 다시 잴 때는 1
AGENT_PACK_STAGE=

# 평가 실행 때만 켭니다(eval/protocol.md). 평소에는 비워 둡니다
ERP_EVAL_RESET=
GATEWAY_EVAL_MODE=
GATEWAY_EXTERNAL_LOG=
RAG_MARKERS_FILE=
RAG_EXTRA_DOCS=
