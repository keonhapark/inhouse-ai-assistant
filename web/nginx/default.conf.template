# nginx 공식 이미지가 시작할 때 ${GATEWAY_URL}을 환경 변수로 바꿉니다(/etc/nginx/templates).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # gateway 주소는 시작할 때가 아니라 요청 때 Docker 내장 DNS로 찾습니다.
    # 시작할 때 찾으면 gateway보다 먼저 뜬 web이 "host not found"로 꺼집니다.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway_upstream ${GATEWAY_URL};

    # gateway 계약의 servers가 /api이므로 경로를 그대로 넘깁니다(proxy_pass에 URI를 붙이지 않음).
    location /api/ {
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 채팅 응답은 SSE(text/event-stream)라 버퍼링을 끕니다.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
