{
  "name": "slack-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node --env-file=../../.env dist/main.js",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../contracts/openapi/gateway.yaml --empty-objects-unknown -o src/schema.d.ts",
    "lint": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
